{
    "openapi": "3.1.0",
    "info": {
        "title": "Sample API",
        "version": "1.0.0"
    },
    "paths": {
        "/update/vectorial-db": {
            "post": {
                "summary": "Actualiza la base de datos vectorial con los manuales del eflow",
                "description": "Utiliza los archivos (manuales) en formato pdf guardados en el directorio establecido para convertirlos en vectores y ser posteriormente almacenados en la base de datos vectorial",
                "responses": {
                    "201": {
                        "description": "Base de datos vectorial actualizada",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "Codigo": {
                                            "type": "integer",
                                            "example": 100
                                        },
                                        "Mensaje": {
                                            "type": "integer",
                                            "example": "Se ha actualizado la base de datos vectorial"
                                        },
                                        "Respuesta": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Cuando ocurre un error al momento de actualizar la base de datos vecotrial",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "Codigo": {
                                            "type": "integer",
                                            "example": 400
                                        },
                                        "Mensaje": {
                                            "type": "string",
                                            "example": "Ocurrió un error"
                                        },
                                        "Respuesta": {
                                            "type": "boolean",
                                            "example": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/load/document": {
            "post": {
                "summary": "Registra un nuevo documento en el directorio y en la base de datos vectorial",
                "description": "Actualizar la base de datos vecotria y también lo Registra en el file system",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "Archivo": {
                                        "type": "string",
                                        "example": "JVBERi0xLjQKJeLjz9MKMSAwIG9iago8PC9D...",
                                        "description": "Archivo del manual en formato base64"
                                    },
                                    "NombreArchivo": {
                                        "type": "string",
                                        "example": "manual.pdf",
                                        "description": "Nombre del Archivo"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Se ha registrado el archivo",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "Codigo": {
                                            "type": "integer",
                                            "example": 100
                                        },
                                        "Mensaje": {
                                            "type": "integer",
                                            "example": "Se ha actualizado la base de datos vectorial"
                                        },
                                        "Respuesta": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Error en la rquest",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "Codigo": {
                                            "type": "integer",
                                            "example": 300
                                        },
                                        "Mensaje": {
                                            "type": "integer",
                                            "example": "Campos no válidos"
                                        },
                                        "Respuesta": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Cuando ocurre un error al momento de actualizar la base de datos vecotrial",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "Codigo": {
                                            "type": "integer",
                                            "example": 400
                                        },
                                        "Mensaje": {
                                            "type": "string",
                                            "example": "Ocurrió un error"
                                        },
                                        "Respuesta": {
                                            "type": "boolean",
                                            "example": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/rag/query": {
            "post": {
                "summary": "Recupera la información de la base de datos vectorial",
                "description": "Realiza una consulta a la base de datos vectorial para recuperar el contexto para el asistente virtual",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "query": {
                                        "type": "string",
                                        "example": "¿Qué es eflow?",
                                        "description": "Pregunta del usuario al asistente virtual"
                                    },
                                    "sources": {
                                        "type": "array",
                                        "items": {
                                            "type": "string"
                                        },
                                        "example": [
                                            "MANUAL EFLOW.pdf",
                                            "HELPDESK MICROSOFT.pdf"
                                        ],
                                        "description": "Fuentes desde dónde se recuperará la información de la base de datos vectorial"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Se ha recuperado la información",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "Codigo": {
                                            "type": "integer",
                                            "example": 100
                                        },
                                        "Fragmentos": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "documento": {
                                                        "type": "string"
                                                    },
                                                    "source": {
                                                        "type": "string"
                                                    }
                                                }
                                            },
                                            "example": [
                                                {
                                                    "documento": "eFlow es una aplicación WorkFlow que permite la implementación, automatización y seguimiento de procesos de toda índole en los que se involucran tareas...",
                                                    "source": "MANUAL EFLOW.pdf"
                                                }
                                            ]
                                        },
                                        "Mensaje": {
                                            "type": "string",
                                            "example": "Se ha actualizado la base de datos vectorial"
                                        },
                                        "Respuesta": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Error en la rquest",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "Codigo": {
                                            "type": "integer",
                                            "example": 300
                                        },
                                        "Fragmentos": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "documento": {
                                                        "type": "string"
                                                    },
                                                    "source": {
                                                        "type": "string"
                                                    }
                                                }
                                            },
                                            "example": []
                                        },
                                        "Mensaje": {
                                            "type": "integer",
                                            "example": "Campos no válidos"
                                        },
                                        "Respuesta": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Cuando ocurre un error al momento de actualizar la base de datos vecotrial",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "Codigo": {
                                            "type": "integer",
                                            "example": 400
                                        },
                                        "Fragmentos": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "documento": {
                                                        "type": "string"
                                                    },
                                                    "source": {
                                                        "type": "string"
                                                    }
                                                }
                                            },
                                            "example": []
                                        },
                                        "Mensaje": {
                                            "type": "string",
                                            "example": "Ocurrió un error"
                                        },
                                        "Respuesta": {
                                            "type": "boolean",
                                            "example": false
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/rag/indexed_documents": {
            "get": {
                "summary": "Recupera los documentos indexados",
                "description": "Servicio que recupera la información de los documentos indexados en la base de datos vectorial",
                "responses": {
                    "200": {
                        "description": "Consulta exitosa",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "Codigo": {
                                            "type": "integer",
                                            "example": 100
                                        },
                                        "Mensaje": {
                                            "type": "string",
                                            "example": "Se han recuperado los documentos indexados"
                                        },
                                        "Respuesta": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "IndexedDocuments": {
                                            "type": "array",
                                            "items": {
                                                "type": "object",
                                                "properties": {
                                                    "document_id": {
                                                        "type": "integer",
                                                        "example": 101,
                                                        "description": "Identificador único del documento indexado."
                                                    },
                                                    "file_name": {
                                                        "type": "string",
                                                        "example": "manual_usuario.pdf",
                                                        "description": "Nombre del archivo original."
                                                    },
                                                    "file_path": {
                                                        "type": "string",
                                                        "example": "/data/docs/manual_usuario.pdf",
                                                        "description": "Ruta donde se encuentra almacenado el archivo."
                                                    },
                                                    "file_hash": {
                                                        "type": "string",
                                                        "example": "af9e23b8e912a4e...",
                                                        "description": "Hash único del archivo para evitar duplicados."
                                                    },
                                                    "file_source": {
                                                        "type": "string",
                                                        "example": "manual_usuario.pdf",
                                                        "description": "Fuente o nombre original del documento."
                                                    },
                                                    "indexed_at": {
                                                        "type": "string",
                                                        "format": "date-time",
                                                        "example": "2025-11-06T15:00:00Z",
                                                        "description": "Fecha y hora en que se indexó el documento."
                                                    },
                                                    "indexed_by": {
                                                        "type": "string",
                                                        "example": "ernesto.vilela",
                                                        "description": "Usuario o proceso que realizó la indexación."
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "example": "indexed",
                                                        "description": "Estado actual del documento (por ejemplo, 'indexed', 'pending', 'error')."
                                                    },
                                                    "embedding_model": {
                                                        "type": "string",
                                                        "example": "text-embedding-3-small",
                                                        "description": "Modelo de embeddings utilizado para indexar el documento."
                                                    },
                                                    "chunk_count": {
                                                        "type": "integer",
                                                        "example": 32,
                                                        "description": "Cantidad de fragmentos o chunks generados del documento."
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Error en la request",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "Codigo": {
                                            "type": "integer",
                                            "example": 300
                                        },
                                        "Mensaje": {
                                            "type": "integer",
                                            "example": "No se encontraro documentos indexados"
                                        },
                                        "Respuesta": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "IndexedDocuments": {
                                            "type": "array",
                                            "example": []
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "En la consulta de los documentos indexados",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "Codigo": {
                                            "type": "integer",
                                            "example": 400
                                        },
                                        "Mensaje": {
                                            "type": "string",
                                            "example": "Ocurrió un error"
                                        },
                                        "Respuesta": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "IndexedDocuments": {
                                            "type": "array",
                                            "example": []
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}